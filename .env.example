# PlanosSF — exemplo de configuração. NUNCA coloque credenciais reais neste arquivo.
APP_NAME=PlanosSF
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://planos.exemplo.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planossf
DB_USERNAME=planossf
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
# Contratos e anexos: área privada fora de public/, com backup externo.
PLANOS_DOCUMENTS_ROOT=/var/www/planossf/storage/app/private/documents

# Fila e cache no Redis; o MySQL guarda os registros definitivos (inbox/outbox).
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@exemplo.com.br"
MAIL_FROM_NAME="São Francisco Planos"

# ---- Regras do PlanosSF ----
PLANOS_HOMOLOGATION=true
PLANOS_SHOW_TEST_CODES=false
PLANOS_OTP_REQUIRED=true
PLANOS_PROPOSAL_EXPIRY_DAYS=7
PLANOS_LINK_EXPIRY_DAYS=7
PLANOS_RESERVATION_TTL_HOURS=48
PLANOS_FINANCIAL_MAX_STALENESS_HOURS=26

# Cobrança: "fake" (simulador de homologação) ou "vindi".
PLANOS_BILLING_DRIVER=fake
VINDI_BASE_URL=https://sandbox-app.vindi.com.br/api/v1
VINDI_API_KEY=
VINDI_PLAN_ID=
VINDI_PRODUCT_ID=
VINDI_ENROLLMENT_PRODUCT_ID=
VINDI_PAYMENT_METHOD=credit_card
# Segredo aleatório usado na URL do webhook: /webhooks/vindi/{segredo}
VINDI_WEBHOOK_SECRET=

# Integrações sem API confirmada permanecem manuais e auditadas.
PLANOS_SIMPLESVET_MODE=manual
PLANOS_TUDOPRAPET_MODE=manual
